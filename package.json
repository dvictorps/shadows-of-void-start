{
	"name": "shadows-of-void-start",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev --port 3002",
		"build": "vite build",
		"build:staging": "vite build --mode staging",
		"preview": "vite preview",
		"deploy:staging": "pnpm build:staging && wrangler deploy",
		"deploy:production": "vite build --mode production && wrangler deploy",
		"cf-typegen": "wrangler types --env-file .dev.vars.example",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"db:migrate:staging": "wrangler d1 migrations apply DB --env staging --remote",
		"db:migrate:production": "wrangler d1 migrations apply DB --env production --remote",
		"test": "vitest run",
		"format": "oxfmt",
		"lint": "oxlint --disable-nested-config",
		"lint:errors": "oxlint --quiet --disable-nested-config",
		"lint:fix": "oxlint --fix --disable-nested-config",
		"format:check": "oxfmt --check",
		"test:lint-rules": "node --test \"tools/oxlint/**/*.test.ts\"",
		"prepare": "lefthook install && pnpm cf-typegen",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@posthog/react": "^1.7.0",
		"@t3-oss/env-core": "^0.13.10",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/match-sorter-utils": "latest",
		"@tanstack/react-devtools": "latest",
		"@tanstack/react-form": "latest",
		"@tanstack/react-query": "latest",
		"@tanstack/react-query-devtools": "latest",
		"@tanstack/react-router": "latest",
		"@tanstack/react-router-devtools": "latest",
		"@tanstack/react-router-ssr-query": "latest",
		"@tanstack/react-start": "latest",
		"@tanstack/react-table": "latest",
		"@tanstack/router-plugin": "^1.132.0",
		"@trpc/client": "^11.28.2",
		"@trpc/server": "^11.28.2",
		"@trpc/tanstack-react-query": "^11.28.2",
		"better-auth": "~1.5.6",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.4",
		"framer-motion": "^12.38.0",
		"lucide-react": "^1.7.0",
		"posthog-js": "^1.358.1",
		"radix-ui": "^1.4.3",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.0.2",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.3.6",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.69.1",
		"@cloudflare/vitest-plugin": "^1.8.2",
		"@inlang/paraglide-js": "^2.13.1",
		"@oxlint/plugins": "1.78.0",
		"@shadcn/lint": "^0.1.5",
		"@tailwindcss/typography": "^0.5.16",
		"@tanstack/devtools-vite": "latest",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.0",
		"@types/node": "^25.5.2",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"drizzle-kit": "^0.31.11",
		"eslint-plugin-react-you-might-not-need-an-effect": "^1.2.0",
		"jsdom": "^29.0.2",
		"lefthook": "^2.2.2",
		"oxfmt": "0.63.0",
		"oxlint": "1.82.0",
		"oxlint-tsgolint": "^7.0.2007",
		"typescript": "^6.0.2",
		"vite": "^8.0.7",
		"vitest": "^4.1.3",
		"wrangler": "^4.162.0"
	}
}
